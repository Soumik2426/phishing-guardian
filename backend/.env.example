
# Phishing Guardian Backend Configuration

# Application
APP_NAME=Phishing Guardian API
APP_VERSION=2.0.0
ENVIRONMENT=your_designated_env
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Machine Learning Model
# Local path relative to the backend directory
LOCAL_MODEL_PATH=your_model_path

# AWS S3 Configuration
# Used only when the local model is unavailable
AWS_REGION=your_aws_region
S3_BUCKET=your-s3-bucket-name
S3_MODEL_KEY=your_s3_model_key

# DATABASE
DATABASE_HOST=your_host
DATABASE_PORT=your_port
DATABASE_NAME=your_database_name
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password

# JWT
JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=your_JWT_algorithm
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7